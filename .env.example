# Organiser passcode for the /admin verification console.
# Copy this file to `.env` and set a value, then restart the dev server.
# REQUIRED: if unset, the /admin console cannot be unlocked at all (no default
# passcode ships, because this repository is public).
#
# NOTE: this value is compiled into the JavaScript bundle and is therefore NOT a
# security boundary — anyone who reads the bundle can recover it. It only stops a
# delegate wandering into the console. The enforceable check is server-side:
# the `admins` table and `is_admin()` in Postgres, which every verification RPC calls.
VITE_ADMIN_PASSCODE=

# Supabase (project: striatum-4, ap-south-1)
VITE_SUPABASE_URL=https://nvuzxbexsleajcjwbxpm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
